# Local development: start scripts/preview-api.py alongside Next.js.
NEXT_PUBLIC_API_URL=/api
LUMITUDY_API_TARGET=http://127.0.0.1:8000
NEXT_PUBLIC_LOCAL_API=true

# Production on Vercel: use https://api.lumitudy.com for NEXT_PUBLIC_API_URL
# and false for NEXT_PUBLIC_LOCAL_API. Never put provider keys here.
